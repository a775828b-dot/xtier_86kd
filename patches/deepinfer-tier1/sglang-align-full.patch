@@ -0,0 +1,28 @@
+"""DeepInfer numeric-alignment switches (tf500 align work).
+
+SGLANG_DI_ALIGN=1 turns every item on; SGLANG_DI_ALIGN_<ITEM>=0/1 overrides one item.
+Items: A1 SWA FP8 scale floor, A2 FP4 main-KV reciprocal, A3 index K/Q single cast,
+A4 index-logit DeepGEMM reduction, A5 wo_a FP8 input, A7 exact MXFP8 activation cast,
+A8 MoE FP8 activations (DeepGEMM mega-MoE epilogue).
+Values are read once per process; kernels that are JIT-compiled must put the flag in their cache key.
+"""
+from __future__ import annotations
+
+import functools
+import os
+
+ITEMS = ("A1", "A2", "A3", "A4", "A5", "A7", "A8")
+_TRUE = ("1", "true", "yes", "on")
+
+
+@functools.lru_cache(maxsize=None)
+def enabled(item: str) -> bool:
+    assert item in ITEMS, item
+    v = os.environ.get(f"SGLANG_DI_ALIGN_{item}", "")
+    if v != "":
+        return v.strip().lower() in _TRUE
+    return os.environ.get("SGLANG_DI_ALIGN", "0").strip().lower() in _TRUE
+
+
+def summary() -> str:
+    return ",".join(f"{k}={int(enabled(k))}" for k in ITEMS)
