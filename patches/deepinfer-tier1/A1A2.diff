+"""Cache-isolated JIT options for the A1/A2 KV writer alignment."""
+from sglang.kernels.jit.utils import load_jit
+from sglang.srt.layers.attention.dsv4 import di_align
+
+
+def load_kv_align_jit(name, *args, **kwargs):
+    a1, a2 = int(di_align.enabled("A1")), int(di_align.enabled("A2"))
+    flags = list(kwargs.pop("extra_cuda_cflags", []))
+    flags += [f"-DSGLANG_DI_ALIGN_A1={a1}", f"-DSGLANG_DI_ALIGN_A2={a2}"]
+    return load_jit(f"{name}_di_a1{a1}_a2{a2}", *args,
+                    extra_cuda_cflags=flags, **kwargs)
